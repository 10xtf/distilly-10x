{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "paths": {
      "@distilly/mcp": ["./packages/mcp/src/index.ts"],
      "@distilly/mcp/stdio": ["./packages/mcp/src/stdio.ts"],
      "@distilly/protocol": ["./packages/protocol/src/index.ts"],
      "distilly": ["./packages/distilly/src/index.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
